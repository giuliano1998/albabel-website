diff --git a/src/styles.css b/src/styles.css
index 6d88f90..da906d0 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -144,3 +144,60 @@ footer{background:var(--navy-900);color:rgba(255,255,255,.7);}
 footer a:hover{color:var(--gold);}
 
 .hidden-h{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);}
+
+/* ============ REDISEÑO 2026 ============ */
+:root{ --section-y:clamp(58px,7.5vw,108px); }
+
+/* logo navbar (wordmark recortado, más grande y legible) */
+.nav-logo{height:32px;max-width:60vw;}
+.nav.scrolled .nav-logo{height:28px;}
+
+/* iconos de línea */
+.icon{display:block;flex:none;}
+
+/* nav links: subrayado animado */
+.nav-links a::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:2px;border-radius:2px;background:var(--green);transform:scaleX(0);transform-origin:left;transition:transform .3s ease;}
+.nav-links a:hover::after{transform:scaleX(1);}
+
+/* sección de video centrada (estilo NOUFON) */
+.video-feature .vf-inner{max-width:920px;margin:0 auto;text-align:center;}
+.vf-title{margin-top:16px;}
+.vf-video{max-width:880px;margin:38px auto 30px;}
+.vf-desc{max-width:700px;margin:0 auto;}
+.vf-desc strong{color:inherit;font-weight:800;}
+.vf-cta{margin-top:30px;}
+
+/* feature panels (Problema / Diferenciales) — reemplazan a las cards con emoji */
+.feat{position:relative;padding:26px 24px;border-radius:16px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.035);transition:border-color .35s,background .35s,transform .35s;}
+.feat:hover{border-color:rgba(214,173,96,.5);background:rgba(255,255,255,.06);transform:translateY(-5px);}
+.feat-ic{display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:13px;color:var(--gold);background:rgba(214,173,96,.13);border:1px solid rgba(214,173,96,.28);transition:background .35s,color .35s;}
+.feat:hover .feat-ic{background:var(--gold);color:var(--navy-900);}
+.feat-t{font-size:1.2rem;margin-top:16px;color:#fff;letter-spacing:-.01em;}
+.feat-d{margin-top:9px;font-size:.96rem;}
+
+/* punch line del Problema */
+.problema-punch{text-align:center;margin-top:48px;font-size:clamp(1.2rem,2.4vw,1.6rem);font-weight:800;color:#fff;letter-spacing:-.01em;}
+.problema-punch span{display:block;color:var(--gold);font-weight:700;font-size:.74em;margin-top:8px;}
+
+/* pillars (Servicios) — números grandes + icono + accent animado */
+.pillar{position:relative;padding:32px 26px 28px;border-radius:18px;border:1px solid var(--line);background:#fff;overflow:hidden;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s;}
+.pillar::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--gold),var(--green));transform:scaleX(0);transform-origin:left;transition:transform .45s ease;}
+.pillar:hover{transform:translateY(-6px);box-shadow:var(--shadow-md);border-color:transparent;}
+.pillar:hover::before{transform:scaleX(1);}
+.pillar .step-tag{position:absolute;top:18px;right:22px;font-weight:800;font-size:2.7rem;color:rgba(15,44,89,.07);letter-spacing:-.04em;}
+.pillar .pic{display:inline-flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:14px;background:var(--gold-soft);color:var(--navy);margin-bottom:16px;font-size:inherit;transition:background .35s,color .35s;}
+.pillar:hover .pic{background:var(--navy);color:var(--gold);}
+.pillar-t{font-size:1.35rem;letter-spacing:-.01em;}
+.pillar-list{list-style:none;margin-top:16px;display:grid;gap:9px;}
+.pillar-list li{display:flex;gap:9px;align-items:center;font-size:.9rem;font-weight:600;color:var(--navy);}
+.pillar-list li .icon{color:var(--green);}
+
+/* checklist (Solución) — sin cards, con divisor fino */
+.check-item{display:flex;gap:14px;align-items:flex-start;padding:15px 0;border-bottom:1px solid rgba(15,44,89,.08);}
+.check-item:last-child{border-bottom:none;}
+.check-ic{flex:none;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:9px;background:var(--green);color:#fff;}
+
+/* entrada suave al revelar */
+@media (prefers-reduced-motion: no-preference){
+  .pillar,.feat{will-change:transform;}
+}
